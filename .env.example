# Local development only. Never commit a real .env file.
# In GCP these values come from Secret Manager, mounted at runtime.

POSTGRES_USER=jenie
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=jenie
DATABASE_URL=postgresql://jenie:change-me-locally@postgres:5432/jenie

REDIS_URL=redis://redis:6379/0

EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=768

LLM_PROVIDER=mock
LLM_MODEL=mock-1
# Cost proxy used to derive llm_cost_usd_total from token counts.
LLM_INPUT_COST_PER_1K=0.00015
LLM_OUTPUT_COST_PER_1K=0.0006

# Host ports. Override if something already uses these locally.
API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

TOP_K=5
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
DATA_PATH=/data
